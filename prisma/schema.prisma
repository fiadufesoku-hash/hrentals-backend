generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id               Int      @id @default(autoincrement())
  startDate        DateTime
  endDate          DateTime
  totalAmount      Float
  status           String   @default("pending")
  userId           Int
  propertyId       Int
  createdAt        DateTime @default(now())
  commissionAmount Float    @default(0)
  companyId        Int
  momoTxId         String?
  company          company  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Booking_companyId_fkey")
  property         property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Booking_propertyId_fkey")
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Booking_userId_fkey")

  @@index([companyId], map: "Booking_companyId_fkey")
  @@index([propertyId], map: "Booking_propertyId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
}

model company {
  id           Int        @id @default(autoincrement())
  name         String     @unique(map: "Company_name_key")
  logoUrl      String?
  contact      String
  isOwnCompany Boolean    @default(false)
  momoAccount  String?
  createdAt    DateTime   @default(now())
  booking      booking[]
  property     property[]
  user         user[]
}

model property {
  id            Int             @id @default(autoincrement())
  title         String
  location      String
  price         Float
  description   String?
  ownerId       Int
  createdAt     DateTime        @default(now())
  companyId     Int
  contact       String?
  imageUrl      String?
  status        String?         @default("available")
  type          String?
  booking       booking[]
  company       company         @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Property_companyId_fkey")
  user          user            @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "Property_ownerId_fkey")
  propertyimage propertyimage[]

  @@index([companyId], map: "Property_companyId_fkey")
  @@index([ownerId], map: "Property_ownerId_fkey")
}

model propertyimage {
  id         Int      @id @default(autoincrement())
  url        String
  caption    String?
  order      Int
  propertyId Int
  createdAt  DateTime @default(now())
  property   property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "PropertyImage_propertyId_fkey")

  @@index([propertyId], map: "PropertyImage_propertyId_fkey")
}

model user {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique(map: "User_email_key")
  password  String
  role      String     @default("user")
  createdAt DateTime   @default(now())
  companyId Int?
  phone     String?
  booking   booking[]
  property  property[]
  company   company?   @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "User_companyId_fkey")

  @@index([companyId], map: "User_companyId_fkey")
}
