generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("user")
  phone     String?
  companyId Int?
  createdAt DateTime  @default(now())

  bookings   booking[]
  properties property[]
  company    company?  @relation(fields: [companyId], references: [id])
}

model company {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  logoUrl      String?
  contact      String
  isOwnCompany Boolean  @default(false)
  momoAccount  String?
  createdAt    DateTime @default(now())

  users        user[]
  properties   property[]
  bookings     booking[]
}

model property {
  id          Int      @id @default(autoincrement())
  title       String
  location    String
  price       Float
  description String?
  imageUrl    String?
  status      String   @default("available")
  type        String?
  contact     String?
  ownerId     Int
  companyId   Int
  createdAt   DateTime @default(now())

  owner       user     @relation(fields: [ownerId], references: [id])
  company     company  @relation(fields: [companyId], references: [id])
  bookings    booking[]
  images      propertyimage[]
}

model propertyimage {
  id         Int      @id @default(autoincrement())
  url        String
  caption    String?
  order      Int      @default(0)
  propertyId Int
  createdAt  DateTime @default(now())

  property   property @relation(fields: [propertyId], references: [id])
}

model booking {
  id               Int      @id @default(autoincrement())
  startDate        DateTime
  endDate          DateTime
  totalAmount      Float
  status           String   @default("pending")
  commissionAmount Float    @default(0)
  momoTxId         String?
  userId           Int
  propertyId       Int
  companyId        Int
  createdAt        DateTime @default(now())

  user             user     @relation(fields: [userId], references: [id])
  property         property @relation(fields: [propertyId], references: [id])
  company          company  @relation(fields: [companyId], references: [id])
}